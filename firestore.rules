rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Leads collection rules: Allow public creation for sharable forms, full access for logged-in staff
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Custom Forms collection rules: Allow public read/submission counter, staff full control
    match /custom_forms/{formId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if request.auth != null;
    }

    // Webhooks collection rules: Allow public read/update for webhook endpoint ingestion, staff full control
    match /webhooks/{webhookId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if request.auth != null;
    }

    // Settings document rules
    match /settings/config {
      allow read, write: if request.auth != null;
    }

    // Courses collection rules
    match /courses/{courseId} {
      allow read, write: if request.auth != null;
    }

    // Batches collection rules
    match /batches/{batchId} {
      allow read, write: if request.auth != null;
    }

    // WhatsApp templates collection rules
    match /whatsapp_templates/{templateId} {
      allow read, write: if request.auth != null;
    }

    // Email templates collection rules
    match /email_templates/{templateId} {
      allow read, write: if request.auth != null;
    }
  }
}
