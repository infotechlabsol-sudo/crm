{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Student inquiry lead",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "source": { "type": "string" },
        "course_interest": { "type": "string" },
        "status": { "type": "string" },
        "assigned_batch": { "type": "string" },
        "lead_score": { "type": "string" },
        "created_date": { "type": "string" },
        "last_contacted_date": { "type": "string" },
        "next_followup_date": { "type": "string" },
        "tags": { "type": "array" },
        "address": { "type": "string" },
        "converted_to_student": { "type": "boolean" },
        "is_deleted": { "type": "boolean" },
        "deleted_date": { "type": "string" }
      },
      "required": ["name", "phone", "source", "course_interest", "status", "assigned_batch", "lead_score", "created_date"]
    },
    "CRMSettings": {
      "title": "CRM Settings",
      "description": "CRM Configuration and message templates",
      "type": "object",
      "properties": {
        "courses": { "type": "array" },
        "sources": { "type": "array" },
        "batches": { "type": "array" },
        "whatsappTemplates": { "type": "array" }
      },
      "required": ["courses", "sources", "batches", "whatsappTemplates"]
    },
    "Course": {
      "title": "Course",
      "description": "Course offered by the academy",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "created_timestamp": { "type": "string" }
      },
      "required": ["name", "active"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Course batch schedule",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "created_timestamp": { "type": "string" }
      },
      "required": ["name", "active"]
    },
    "WhatsAppTemplate": {
      "title": "WhatsApp Template",
      "description": "Template for WhatsApp messages with placeholders",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "message": { "type": "string" },
        "created_timestamp": { "type": "string" }
      },
      "required": ["name", "message"]
    },
    "EmailTemplate": {
      "title": "Email Template",
      "description": "Rich HTML template for Email messages with placeholders",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "created_timestamp": { "type": "string" }
      },
      "required": ["name", "subject", "message"]
    },
    "CustomForm": {
      "title": "Custom Form",
      "description": "Sharable lead capture form",
      "type": "object",
      "properties": {
        "form_name": { "type": "string" },
        "form_title": { "type": "string" },
        "form_description": { "type": "string" },
        "fields": { "type": "array" },
        "active": { "type": "boolean" },
        "created_timestamp": { "type": "string" },
        "submission_count": { "type": "number" }
      },
      "required": ["form_name", "form_title", "fields", "active"]
    },
    "Webhook": {
      "title": "Webhook Endpoint",
      "description": "Configured webhook endpoint for external lead ingestion",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "webhook_key": { "type": "string" },
        "active": { "type": "boolean" },
        "created_timestamp": { "type": "string" },
        "last_received_timestamp": { "type": "string" },
        "total_received": { "type": "number" }
      },
      "required": ["name", "webhook_key", "active", "created_timestamp", "total_received"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of student inquiry leads"
    },
    "/custom_forms/{formId}": {
      "schema": "CustomForm",
      "description": "Collection of sharable lead capture forms"
    },
    "/webhooks/{webhookId}": {
      "schema": "Webhook",
      "description": "Collection of configured webhook endpoints"
    },
    "/settings/config": {
      "schema": "CRMSettings",
      "description": "System-wide settings and templates config document"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Collection of available course options"
    },
    "/batches/{batchId}": {
      "schema": "Batch",
      "description": "Collection of available batch options"
    },
    "/whatsapp_templates/{templateId}": {
      "schema": "WhatsAppTemplate",
      "description": "Collection of WhatsApp message templates"
    },
    "/email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Collection of Email message templates"
    }
  }
}
